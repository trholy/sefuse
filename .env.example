POSTGRES_DB=sefuse
POSTGRES_USER=sefuse
POSTGRES_PASSWORD=change_me_db_password

AUTH_ENABLED=true
DB_CONNECT_TIMEOUT_SECONDS=5
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

INTERNAL_API_TOKEN=change_me_to_a_random_secret
# Local development only: lets FastAPI start with an empty INTERNAL_API_TOKEN,
# leaving its API unauthenticated inside the Docker network. Logs a warning.
# ALLOW_UNAUTHENTICATED_INTERNAL_API=true
QDRANT_API_KEY=change_me_qdrant_api_key
SESSION_TIMEOUT_MINUTES=30
# Cross-tab session cookies: set to false to disable cookie-based session
# persistence. When disabled, each browser tab requires a separate login.
SESSION_COOKIES_ENABLED=true
# Add the `Secure` attribute to the session cookie so it is only sent over HTTPS.
# Default is false so the out-of-the-box http://localhost deployment can log in.
# Set to true when serving Streamlit behind TLS (recommended for production).
SESSION_COOKIE_SECURE=false

MODEL=bge-m3
TOKENIZER=BAAI/bge-m3

# EU Funding API
# "SEDIA" is the API key of the EU Funding & Tenders Portal search API.
# See API docs: https://api.tech.ec.europa.eu/search-api/prod/rest/swagger-ui.html
EU_API_KEY=SEDIA

# Search & embedding tuning
BM25_K1=1.2
ADAPTIVE_CHUNK_THRESHOLD=600
TOPK_SCORES=3
EMBEDDING_CONCURRENCY=4
# Dense vector dimension — must match the embedding model (bge-m3 = 1024)
VECTOR_DIMENSION=1024
OLLAMA_EMBED_TIMEOUT_SECONDS=120

# Ollama model readiness probe
OLLAMA_MODEL_READY_INTERVAL=10
OLLAMA_MODEL_READY_TIMEOUT=600

# Cron schedule — hour-of-day (0-23) for each pipeline job
CRON_TRIGGER_GERMAN_DATA_PROCESSING=0
CRON_TRIGGER_GERMAN_EMBEDDING=3
CRON_TRIGGER_EU_DATA_PROCESSING=1
CRON_TRIGGER_EU_EMBEDDING=4

# EU API pagination guard. Reaching this limit aborts the fetch rather than
# indexing a result set that is known to be missing its tail.
EU_MAX_PAGES=100

# Data refresh truncation guard. How far the active row count may fall against the
# previous run before the refresh is refused and the previous snapshot is kept —
# 0.2 allows losing a fifth of the dataset. Also gates overwriting the EU JSON
# cache. Protects against a half-downloaded CSV or a short API response being read
# downstream as "these funding programmes were withdrawn" and deleted from Qdrant.
DATA_REFRESH_MAX_DROP_RATIO=0.2

# Master switch for saved-search alerts. Set to false to switch the feature off
# entirely: no nightly check job, no in-app alert inbox, no sidebar badge, and no
# alert controls anywhere in the UI. Saved searches themselves keep working, and
# the database schema is left in place so alerts can be switched back on later.
# Every ALERT_*/GOTIFY_* setting below is ignored while this is false.
ALERTS_ENABLED=true

# Alert check schedule — hour-of-day (0-23, UTC) for daily saved-search alert checks
ALERT_CHECK_HOUR=5

# Alert match levels: a new programme must rank among the saved query's top k existing
# programmes and clear the collection's noise floor (the best cosine any off-topic
# canary query reaches there, plus ALERT_NOISE_MARGIN). Override k as JSON; defaults:
# {"broad": 25, "balanced": 10, "strict": 3}
# ALERT_LEVEL_RULES=
ALERT_NOISE_MARGIN=0.04

# Re-key guard: more new programmes than max(MIN, RATIO x active) in one run are
# treated as upstream ids changing and never alert.
FIRST_SEEN_BURST_MIN=25
FIRST_SEEN_BURST_RATIO=0.1

# A new programme this similar to an existing one is a near-duplicate and never alerts.
DUPLICATE_COSINE=0.97

# How long in-app alert matches are kept before the nightly sweep prunes them.
ALERT_NOTIFICATION_RETENTION_DAYS=30

# ── Gotify push notifications ────────────────────────────────────────────────
# Off by default. When enabled, SeFuSe pushes new saved-search matches through
# ONE central Gotify server that you run; each user then pastes their own
# application token on the Notification Settings page, which is their private
# channel on that server.
GOTIFY_ENABLED=false

# Base URL of your Gotify server, e.g. https://gotify.example.com or
# http://192.168.1.20:8080. A server on your own network is fine; it only has to
# be reachable from the FastAPI and Streamlit containers.
GOTIFY_URL=

# Encrypts users' Gotify tokens at rest. Required when GOTIFY_ENABLED=true.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every stored token; users must re-enter theirs.
GOTIFY_SECRET_KEY=

# Default Gotify message priority (0-10) and HTTP timeout in seconds.
GOTIFY_PRIORITY=5
GOTIFY_TIMEOUT_SECONDS=10

# Login lockout: after this many consecutive failed logins an account is locked
# for the given number of minutes.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# Log level for FastAPI and Streamlit (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO