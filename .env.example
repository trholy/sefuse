POSTGRES_DB=sefuse
POSTGRES_USER=sefuse
POSTGRES_PASSWORD=change_me_db_password

AUTH_ENABLED=true
DB_CONNECT_TIMEOUT_SECONDS=5
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

INTERNAL_API_TOKEN=change_me_to_a_random_secret
SESSION_TIMEOUT_MINUTES=30

MODEL=bge-m3
TOKENIZER=BAAI/bge-m3

# EU Funding API
# "SEDIA" is the public demo key for the EU Funding & Tenders Portal search API.
# See API docs: https://api.tech.ec.europa.eu/search-api/prod/rest/swagger-ui.html
EU_API_KEY=SEDIA

# Search & embedding tuning
BM25_K1=1.2
ADAPTIVE_CHUNK_THRESHOLD=600
TOPK_SCORES=3
EMBEDDING_CONCURRENCY=4
OLLAMA_EMBED_TIMEOUT_SECONDS=120

# Ollama model readiness probe
OLLAMA_MODEL_READY_INTERVAL=10
OLLAMA_MODEL_READY_TIMEOUT=600

# Cron schedule — hour-of-day (0-23) for each pipeline job
CRON_TRIGGER_GERMAN_DATA_PROCESSING=0
CRON_TRIGGER_GERMAN_EMBEDDING=3
CRON_TRIGGER_EU_DATA_PROCESSING=1
CRON_TRIGGER_EU_EMBEDDING=4

# EU API pagination guard
EU_MAX_PAGES=100